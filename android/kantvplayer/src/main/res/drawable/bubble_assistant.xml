<?xml version="1.0" encoding="utf-8"?>
<!--
    Assistant bubble: light gray fill with a thin border, asymmetric
    corners so the tail appears on the left (where the assistant message
    is anchored). Markdown-rendered text keeps the same look as before.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/item_bg_color" />
    <stroke
        android:width="1dp"
        android:color="@color/text_gray" />
    <corners
        android:topLeftRadius="12dp"
        android:topRightRadius="12dp"
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="12dp" />
</shape>
