<?xml version="1.0" encoding="utf-8"?>
<!--
    Assistant chat bubble: left-aligned, light gray background with a thin
    border so it reads as the "system" side of the conversation. While the
    native side is still streaming tokens, the time row shows a "▌" caret
    to give the user immediate feedback that something is happening.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="8dp"
    android:paddingEnd="48dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_assistant"
        android:padding="12dp">

        <TextView
            android:id="@+id/chatAssistantText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_black"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/chatAssistantTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_gray"
        android:textSize="10sp" />
</LinearLayout>
